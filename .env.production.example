# Copy to .env.production before building for production.
# VITE_API_URL is baked into the bundle at BUILD time — changing it later requires a rebuild.
# Use the full public API origin (HTTPS, no trailing slash). "/api" is for local development only,
# unless your host proxies both /api and /ws to the API server.
VITE_API_URL=https://famous-techx-pos-api.onrender.com

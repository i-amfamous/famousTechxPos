{
  "name": "famous-techx-pos-server",
  "private": true,
  "version": "1.0.0",
  "description": "API server for Famous TechX POS (Node.js + Express + TiDB Cloud).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "dev:memory": "node --no-warnings --import tsx scripts/dev-memory.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/scripts/migrate.js && node --env-file-if-exists=.env dist/src/index.js",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "migrate:prod": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "mail:check": "node --env-file-if-exists=.env --import tsx scripts/mail-check.ts",
    "test": "node --no-warnings --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.6.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}

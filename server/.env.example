# ── Database: TiDB Cloud ──────────────────────────────────────────────────────
# TiDB Cloud → your cluster → Connect → "Connect with: General". Copy host, user and password.
# The database (famous_pos) is created by `npm run migrate` if it doesn't exist.
DATABASE_URL=mysql://USER.root:PASSWORD@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/famous_pos
DATABASE_SSL=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
# The website's public address. Used for CORS and in invite / password-reset links.
APP_URL=http://localhost:5173
# Extra allowed origins, comma separated (LAN addresses are always allowed for phone scanning).
# CORS_ORIGINS=https://pos.famoustechx.com

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
# Preferred: Brevo REST API key (Brevo → SMTP & API → API keys, starts with xkeysib-).
# When set, mail uses the API and the SMTP settings below are ignored.
BREVO_API_KEY=your-brevo-api-key
# Fallback: Brevo SMTP relay. SMTP_PASS is the SMTP key (starts with xsmtpsib-), NOT your login password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASS=your-brevo-smtp-key
# MAIL_FROM must be a sender/domain verified in Brevo (Senders & Domains).
# Without any mail config, invite links are shown in the app to share manually.
MAIL_FROM="Famous TechX <no-reply@yourdomain.com>"

# ── Optional ──────────────────────────────────────────────────────────────────
# UPCITEMDB_KEY=           # paid UPCitemdb plan for barcode lookups (free trial is used otherwise)
# BARCODE_ONLINE=false     # turn off online barcode lookups entirely

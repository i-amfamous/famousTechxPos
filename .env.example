# Where the website finds the API server (the `server/` folder).
#   Development:  /api   - Vite forwards it to http://localhost:8080 (phones on your Wi-Fi work too)
#   Production:   the deployed server, e.g. https://famous-techx-pos-api.onrender.com
#   Empty:        demo mode with sample data (no server needed)
VITE_API_URL=/api
